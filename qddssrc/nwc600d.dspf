     A            H1ENAM        30A  O  6 30
     A                                  7 30'MMDDYY'
     A                                      COLOR(BLU)
     A                                  8 30'MMDDYY'
     A                                      COLOR(BLU)
     A            H1SHPN        30A  O  9 30
     A                                 12  2'Ship to'
     A                                      DSPATR(HI)
     A                                 13  4'Name . . . . .'
     A            H1SNAM        40A  B 13 20
     A                                      CHECK(LC)
     A                                 14  4'Address  . . .'
     A            H1SADR        60A  B 14 20
     A                                      CHECK(LC)
     A                                 15  4'City . . . . .'
     A            H1SCTY        15A  B 15 20
     A                                      CHECK(LC)
     A                                 16  4'Region . . . .'
     A            H1SREG        15A  B 16 20
     A                                      CHECK(LC)
     A                                 17  4'Postal code  .'
     A            H1SPST        10A  B 17 20
     A                                      CHECK(LC)
     A                                 18  4'Country  . . .'
     A            H1SCNT        15A  B 18 20
     A                                      CHECK(LC)
     A                                 22  2'F3=Exit   F4=Prompt customer'
     A                                      COLOR(BLU)
     A                                 22 33'F12=Cancel   Enter=Continue'
     A                                      COLOR(BLU)
     A            H1MSG         78A  O 23  2
     A                                      DSPATR(HI)
     A          R LINREC                    CA04(04 'Prompt')
     A                                      CA10(10 'Accept')
