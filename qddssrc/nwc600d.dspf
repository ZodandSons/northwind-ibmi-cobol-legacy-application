     A* ********************************************************************
     A* NWC600D - Order entry - 10 lines per order
     A* ********************************************************************
     A* INDARA - USED BY COBOL WITH WORKSTATION-NWC600D-SI
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      PRINT
     A                                      CA03(03 'Exit')
     A                                      CA12(12 'Cancel')
     A          R HDRREC                    CA04(04 'Prompt')
     A                                  1  2'NWC600D'
     A                                  1 34'Order Entry'
     A                                      DSPATR(HI)
     A                                  1 72DATE
     A                                      EDTCDE(Y)
     A                                  2  2USER
     A                                  2 72TIME
     A                                  5  2'Customer . . . .'
     A            H1CUST         5A  B  5 20
     A  51                                  DSPATR(RI PC)
     A                                  6  2'Employee . . . .'
     A            H1EMP          5Y 0B  6 20
     A                                      EDTCDE(Z)
     A  52                                  DSPATR(RI PC)
     A                                  7  2'Order date . . .'
     A            H1ODAT         6Y 0B  7 20
     A                                      EDTWRD('  /  /  ')
     A  53                                  DSPATR(RI PC)
     A                                  8  2'Required date  .'
     A            H1RDAT         6Y 0B  8 20
     A                                      EDTWRD('  /  /  ')
     A  54                                  DSPATR(RI PC)
     A                                  9  2'Ship via . . . .'
     A            H1SHPV         1A  B  9 20
     A  55                                  DSPATR(RI PC)
     A                                 10  2'Freight  . . . .'
     A            H1FRT          7Y 2B 10 20
     A                                      EDTCDE(1)
