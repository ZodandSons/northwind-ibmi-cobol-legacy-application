               REPLACE(*YES)
  MONMSG     MSGID(CPF0000 LNC0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTBNDCBL  PGM(NWLCBL/NWC620) SRCFILE(NWLCBL/QCBLLESRC) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000 LNC0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- OPM COBOL/400 ------------------------------------------------ */
  CRTCBLPGM  PGM(NWLCBL/NWC700) SRCFILE(NWLCBL/QCBLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000 LBL0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

/* ---- OPM CL ---------------------------------------------------------- */
  CRTCLPGM   PGM(NWLCBL/NWC000C) SRCFILE(NWLCBL/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTCLPGM   PGM(NWLCBL/NWC620C) SRCFILE(NWLCBL/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTCLPGM   PGM(NWLCBL/NWC700C) SRCFILE(NWLCBL/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
  CRTCLPGM   PGM(NWLCBL/NWCNXTC) SRCFILE(NWLCBL/QCLSRC) REPLACE(*YES)
  MONMSG     MSGID(CPF0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))

  CHGVAR     VAR(&ERRTXT) VALUE(&ERRORS)
  SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('NWLCBL setup +
               finished with' *BCAT &ERRTXT *BCAT 'error(s). Start +
               with CALL NWLCBL/NWC000C.') MSGTYPE(*COMP)
  RETURN

  SUBR       SUBR(IMPORT)
    CHGVAR     VAR(&STMF) VALUE(&SRCDIR *TCAT '/' *TCAT &SRCF *TCAT +
                 '/' *TCAT &MBR *TCAT '.' *TCAT &EXT)
    CHGVAR     VAR(&TOMBR) VALUE('/QSYS.LIB/NWLCBL.LIB/' *TCAT &SRCF +
                 *TCAT '.FILE/' *TCAT &MBR *TCAT '.MBR')
    CPYFRMSTMF FROMSTMF(&STMF) TOMBR(&TOMBR) MBROPT(*REPLACE) +
                 STMFCCSID(*STMF) DBFCCSID(*FILE) ENDLINFMT(*ALL)
    MONMSG     MSGID(CPF0000) EXEC(DO)
      CHGVAR     VAR(&ERRORS) VALUE(&ERRORS + 1)
      RTNSUBR
    ENDDO
    CHGPFM     FILE(NWLCBL/&SRCF) MBR(&MBR) SRCTYPE(&TYPE)
    MONMSG     MSGID(CPF0000)
  ENDSUBR
ENDPGM
