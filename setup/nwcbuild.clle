/* ---- ILE COBOL (copy members found in QCBLLESRC via *LIBL) -------- */
  CRTBNDCBL  PGM(NWLCBL/NWC100) SRCFILE(NWLCBL/QCBLLESRC) +
               REPLACE(*YES)
  MONMSG     MSGID(CPF0000 LNC0000) EXEC(CHGVAR VAR(&ERRORS) VALUE(&ERRORS + 1))
