/*===================================================================*/
/* NWCBUILD - Set up the COBOL edition of the NWLEGACY training app  */
/*                                                                   */
/* SETUP TOOLING - NOT PART OF THE LEGACY APPLICATION.               */
/*  The COBOL programs use the SAME data library as the RPG edition, */
/*  so run NWLBUILD from the RPG package first (it creates and       */
/*  loads NWLEGDTA).  This program then:                             */
/*  1. Creates library NWLCBL (hard coded in NWC000C and NWC700C).   */
/*  2. Copies the IFS sources into source files in NWLCBL.           */
/*  3. Compiles display files, ILE COBOL, OPM COBOL and CL programs. */
/*  Copy members (xxxCP, DATEPRC) are not compiled.                  */
/*                                                                   */
/* The source folder must be in the root (case-insensitive) file    */
/* system, not /QOpenSys - member paths are built in upper case.    */
/*                                                                   */
/* CALL NWCBUILD PARM(('/home/me/nwlcobol' (*CHAR 128)))             */
/*===================================================================*/
PGM        PARM(&SRCDIR)
  DCL        VAR(&SRCDIR) TYPE(*CHAR) LEN(128)
  DCL        VAR(&SRCF)   TYPE(*CHAR) LEN(10)
  DCL        VAR(&MBR)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&EXT)    TYPE(*CHAR) LEN(10)
  DCL        VAR(&TYPE)   TYPE(*CHAR) LEN(10)
  DCL        VAR(&STMF)   TYPE(*CHAR) LEN(256)
  DCL        VAR(&TOMBR)  TYPE(*CHAR) LEN(128)
  DCL        VAR(&ERRORS) TYPE(*DEC)  LEN(5 0) VALUE(0)
  DCL        VAR(&ERRTXT) TYPE(*CHAR) LEN(5)

  CHKOBJ     OBJ(QSYS/NWLEGDTA) OBJTYPE(*LIB)
  MONMSG     MSGID(CPF9801) EXEC(DO)
    SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('Library NWLEGDTA +
                 not found - run NWLBUILD from the RPG edition +
                 first') MSGTYPE(*ESCAPE)
  ENDDO
  CRTLIB     LIB(NWLCBL) TEXT('Northwind legacy - COBOL programs')
  MONMSG     MSGID(CPF2111)
  ADDLIBLE   LIB(NWLEGDTA)
  MONMSG     MSGID(CPF2103)
  ADDLIBLE   LIB(NWLCBL)
  MONMSG     MSGID(CPF2103)
  CRTSRCPF   FILE(NWLCBL/QDDSSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLCBL/QCBLLESRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLCBL/QCBLSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)
  CRTSRCPF   FILE(NWLCBL/QCLSRC) RCDLEN(92)
  MONMSG     MSGID(CPF7302)

/* ---- copy sources ------------------------------------------------- */
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NWC000D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
  CHGVAR     VAR(&SRCF) VALUE('QDDSSRC')
  CHGVAR     VAR(&MBR) VALUE('NWC100D')
  CHGVAR     VAR(&EXT) VALUE('DSPF')
  CHGVAR     VAR(&TYPE) VALUE('DSPF')
  CALLSUBR   SUBR(IMPORT)
